# ── Firebase (client-side, safe to expose) ────────────────────────────────────
# Use the on-the-road-dev project's config here for local dev — NOT
# on-the-road-trip (production). Keeps local testing from ever touching real
# user data. See SETUP.md "Environment variables" for how to set up
# on-the-road-dev if it doesn't exist yet.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── AI (server-side ONLY — no VITE_ prefix) ──────────────────────────────────
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Model for the full city guide + safety card. Blank → 'deepseek-v4-flash'
# (cheap, fast, fine for structured travel copy). Set to 'deepseek-v4-pro' to
# upgrade prose quality (~6x the cost).
# NEVER use the legacy 'deepseek-chat' / 'deepseek-reasoner' names — DeepSeek
# retired them on 2026-07-24 and now routes them to a reasoning model that
# ignores max_tokens and burns ~30x the tokens on hidden chain-of-thought.
DEEPSEEK_MODEL=
# Light model — "load more", journal recap, checklist check. Blank →
# 'deepseek-v4-flash'. Same legacy-name warning as above.
DEEPSEEK_MODEL_LIGHT=
# Tavily web search — grounds the guide in current web facts. https://app.tavily.com/
# OFF by default (it adds input-token + Tavily-quota cost per generation).
# Set GUIDE_USE_TAVILY=1 to enable.
TAVILY_API_KEY=
GUIDE_USE_TAVILY=
# Unsplash (optional card photos): https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# ── Google Places (server-side ONLY — proxied via /api/places) ───────────────
# Used by Nomad place search/details/photos. NEVER expose this to the browser;
# the proxy keeps it server-side. Restrict the key to the Places API in GCP.
GOOGLE_PLACES_KEY=
# Signs short-lived (15 min) photo URLs so the <img> redirect endpoint
# (op=photo) isn't an open proxy — minted by op=photo-sign, which requires a
# Firebase ID token. Any long random string; generate with e.g.
# `openssl rand -hex 32`.
PLACES_PHOTO_SECRET=

# ── Google Maps Embed (client-side — safe IF referrer-locked) ────────────────
# Only the interactive map iframe in Nomad uses this. The embed API can't be
# proxied, so this key is in the page — lock it to your domain via an HTTP
# referrer restriction in GCP, and enable ONLY the Maps Embed API on it.
# Leave blank to fall back to the keyless maps.google.com embed.
VITE_MAPS_EMBED_KEY=

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Minify the JSON to a single line before pasting.
# MUST be a service account from the SAME project as VITE_FIREBASE_PROJECT_ID
# above (on-the-road-dev for local dev) — this key is what api/_guard.ts and
# api/_billing.ts use to read/write Firestore directly, bypassing the client
# SDK. A mismatched project here means server writes silently land somewhere
# the client never reads from.
FIREBASE_SERVICE_ACCOUNT=

# ── Lemon Squeezy payments ────────────────────────────────────────────────────
# API key: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
# Store ID: LS Dashboard → your store → Settings → numeric store id
LEMON_SQUEEZY_STORE_ID=
# Variant IDs: LS Dashboard → Products → your product → Variants → numeric id
LEMON_SQUEEZY_VARIANT_TRIP=
LEMON_SQUEEZY_VARIANT_LIFETIME=
# AI top-up booster ("AI 加油包"): adds AI_TOPUP_CREDITS (10) to the account pool
LEMON_SQUEEZY_VARIANT_AI_TOPUP=
# Webhook signing secret: LS Dashboard → Webhooks → Add endpoint → copy the secret
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ── App URL (used for post-payment redirect) ──────────────────────────────────
APP_URL=https://easy-on-the-road.vercel.app

# ── Upstash Redis (server-side rate limiting) ────────────────────────────────
# Free tier: https://console.upstash.com/ → Create Database → REST API section.
# api/_ratelimit.ts fails OPEN (no limiting, but no error) when these are unset,
# so local dev works without a Redis instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics (Plausible) ─────────────────────────────────────────────────────
# No env var needed — the client script tag in index.html/app.html and the
# server-side call in api/_analytics.ts both hardcode the production domain
# (easy-on-the-road.app) as the Plausible site id. Events sent from localhost
# during dev still report against that site unless you add the domain as a
# separate Plausible site and swap PLAUSIBLE_DOMAIN locally.
