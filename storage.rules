rules_version = '2';

// On the Road — Storage security rules.
// Two upload surfaces:
//   users/{uid}/...        — private uploads (Journal photos). Owner only,
//                             same as before this file grew a second block.
//   trips/{tripId}/...     — trip-scoped uploads (leg cover photos) that
//                             every trip member should be able to see, not
//                             just the uploader. Membership is checked by
//                             reading the trip's Firestore doc, mirroring
//                             firestore.rules' subIsMember() — see that
//                             file's helpers for why the legacy `in` guards
//                             below are required (memberUids/members are
//                             both optional and independently so; reading
//                             an absent field throws rather than returning
//                             null, which would otherwise deny every owner
//                             on a trip that predates the members map).
//
// ⚠️ CROSS-SERVICE IAM DEPENDENCY — deploying this file is not enough.
// The trips/ block below calls firestore.get(), which is a "cross-service"
// rule. That requires the Firebase Storage service agent
// (service-<projectNumber>@gcp-sa-firebasestorage.iam.gserviceaccount.com)
// to hold the "Firebase Rules Firestore Service Agent" role. The CLI/console
// normally PROMPTS to grant it the first time you save such rules — but the
// prompt is interactive, so a non-TTY `firebase deploy` reports a perfectly
// successful deploy while silently leaving the role ungranted. Without it,
// every firestore.get() raises an evaluation error, which Rules treats as
// deny — surfacing in the app as "you don't have permission" even for the
// trip's own owner, with nothing in the deploy output hinting at the cause.
// Verify on the Cloud Console IAM page with "Include Google-provided role
// grants" checked. See Firebase docs: rules/manage-deploy, "Manage
// permissions for cross-service Cloud Storage Security Rules".
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Reads: owner only.
      allow read: if request.auth != null && request.auth.uid == userId;
      // Deletes: owner only (no request.resource on delete).
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Writes (upload): owner only, images/PDFs, max 15 MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /trips/{tripId}/{allPaths=**} {
      function signedIn() {
        return request.auth != null;
      }
      function tripDoc() {
        return firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      }
      function isTripMember() {
        // signedIn() must short-circuit before tripDoc() runs — a `let`
        // binding evaluates eagerly, so putting the Firestore read first
        // would fire it for anonymous/unauthenticated requests too (wasted
        // read, and tripDoc() throwing on a missing doc would mask what's
        // actually a plain "not signed in" denial). tripDoc() itself still
        // throws (denying the request) if the trip doc doesn't exist —
        // deliberately: an upload/read against a dangling or mistyped
        // tripId should fail closed, same as firestore.rules' tripExists().
        return signedIn() && isMemberOfExistingTrip();
      }
      function isMemberOfExistingTrip() {
        let t = tripDoc();
        return ('memberUids' in t && request.auth.uid in t.memberUids)
          || ('members' in t && request.auth.uid in t.members)
          || ('ownerUid' in t && t.ownerUid == request.auth.uid);
      }
      // Reads: any trip member (this is the whole point — a cover photo
      // one member uploads should load for everyone on the trip).
      allow read: if isTripMember();
      // Deletes: any trip member may remove a cover image, same as they
      // can already edit/delete the leg it belongs to in Firestore.
      allow delete: if isTripMember();
      // Writes (upload): any trip member, images only, max 15 MB — covers
      // don't need the PDF allowance users/{uid} has for other uploads.
      allow write: if isTripMember()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
